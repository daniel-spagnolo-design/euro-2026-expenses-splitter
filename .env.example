# Copy to .env.local and fill in. Get these from your Supabase project settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — set as a Supabase Edge Function secret, NOT here:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
